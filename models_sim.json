{
 "description": "Independent side models. Data collection only: nothing here feeds any pick, slip, record or track.",
 "built": "2026-11-07",
 "sample_target": 300,
 "models": [
  {
   "id": "league",
   "name": "League base rate",
   "group": "own",
   "desc": "How often games in the same league finished under the line this season. Needs no outlook data. Season-to-date rates include the games being scored."
  },
  {
   "id": "market",
   "name": "Bet365 price",
   "group": "own",
   "desc": "Bet365 price converted to a chance, with an assumed 5% bookmaker margin removed. Needs no outlook data."
  },
  {
   "id": "poisson",
   "name": "Poisson",
   "group": "total",
   "desc": "Plain Poisson goals around the projected total."
  },
  {
   "id": "negbin",
   "name": "Negative binomial",
   "group": "total",
   "desc": "Like Poisson but allows more wild games (very low and very high scores) than Poisson does. Dispersion fixed at 12, not fitted."
  },
  {
   "id": "bivar",
   "name": "Bivariate Poisson",
   "group": "total",
   "desc": "Home and away goals share a common source, so they move together and very high or very low totals are more likely than plain Poisson. Shared part fixed at 10%, not fitted."
  },
  {
   "id": "markov",
   "name": "Markov chain",
   "group": "total",
   "desc": "Minute-by-minute score chain: the leader slows a little, the trailing team pushes a little."
  },
  {
   "id": "outlook",
   "name": "Outlook chance",
   "group": "outlook",
   "desc": "The outlook data's own Under 2.5 chance, for reference. Not available for Under 3.5."
  },
  {
   "id": "blend",
   "name": "Blend (equal mix)",
   "group": "mix",
   "desc": "Plain average of every model above that has a number for the game, excluding the outlook reference."
  }
 ],
